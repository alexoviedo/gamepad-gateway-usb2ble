{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "strict": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "skipLibCheck": true,
    "types": []
  },
  "include": [
    "webapp/**/*.ts",
    "webapp/**/*.d.ts"
  ],
  "exclude": [
    "webapp/**/*.js"
  ]
}
